{
  "Database": {
    "MigrateOnStartup": true
  },
  "WikiSource": {
    "RootPath": "/app/wiki-content",
    "SourceId": "filesystem",
    "Extensions": [".md", ".markdown"],
    "MaxFileSizeBytes": 5242880,
    "DefaultNamespace": "general"
  },
  "Sync": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "RunOnStartup": true,
    "BatchSize": 100
  },
  "WikiTools": {
    "DefaultTopK": 5,
    "MaxTopK": 25,
    "MaxResponseChars": 100000,
    "PageChunkChars": 20000,
    "SearchTimeoutMs": 3000,
    "MaxListPageSize": 100
  },
  "AccessPolicy": {
    "FullAccessGroups": ["wiki-admins"],
    "AdminGroups": ["wiki-admins"],
    "AuditorGroups": ["wiki-auditors"],
    "PublicNamespaces": ["general"],
    "NamespaceGroups": {
      "runbooks": ["harness", "developers"],
      "internal": ["developers"]
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Partition": "ClientId",
    "General": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "Policies": {
      "search": { "PermitLimit": 120, "WindowSeconds": 60 },
      "admin": { "PermitLimit": 10, "WindowSeconds": 60 },
      "audit": { "PermitLimit": 30, "WindowSeconds": 60 }
    }
  },
  "Jwt": {
    "Issuer": "https://sso.example.internal/realms/corp",
    "Audience": "central-wiki-mcp"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
