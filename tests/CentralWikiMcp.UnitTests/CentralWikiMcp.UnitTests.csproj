    <ProjectReference Include="..\..\src\CentralWikiMcp.Infrastructure\CentralWikiMcp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CentralWikiMcp.Server\CentralWikiMcp.Server.csproj" />
    <ProjectReference Include="..\..\src\stubs\Abdt.Infrastructure.Logging.AspNetCore\Abdt.Infrastructure.Logging.AspNetCore.csproj" />
