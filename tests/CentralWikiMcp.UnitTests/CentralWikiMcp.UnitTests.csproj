<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- xunit.v3 по умолчанию собирает собственный консольный runner;
         этот флаг переключает его на Microsoft.Testing.Platform, которого
         ждёт `dotnet test` в .NET 10 SDK (см. global.json). -->
