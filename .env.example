# Секреты сервиса (NFR-35, FR-46).
# В dev читаются стабом Abdt.Infrastructure.Configuration.Vault из переменных
# окружения с префиксом WIKIMCP_; в prod те же ключи приходят из Kubernetes Secrets.
# Двойное подчёркивание — разделитель уровней конфигурации.
#
# Скопируйте в .env и подставьте свои значения. Файл .env в git не попадает.

# Подключение к PostgreSQL (NFR-12)
WIKIMCP_Database__ConnectionString=Host=postgres;Port=5432;Database=wikimcp;Username=wikimcp;Password=change-me

# Пароль БД для контейнера postgres в docker-compose
POSTGRES_PASSWORD=change-me

# Redis для счётчиков rate limiting (FR-64). Пусто — счётчики в памяти процесса.
WIKIMCP_RateLimiting__RedisConnectionString=redis:6379

# API-ключ сервисного аккаунта harness (FR-42)
WIKIMCP_ApiKeyAuth__Clients__0__ClientId=harness-local
WIKIMCP_ApiKeyAuth__Clients__0__Key=change-me-generate-a-long-random-key
WIKIMCP_ApiKeyAuth__Clients__0__Groups__0=harness
WIKIMCP_ApiKeyAuth__Clients__1__ClientId=admin-local
WIKIMCP_ApiKeyAuth__Clients__1__Key=change-me-too-another-long-random-key
WIKIMCP_ApiKeyAuth__Clients__1__Groups__0=wiki-admins
WIKIMCP_ApiKeyAuth__Clients__1__Groups__1=wiki-auditors

# Параметры проверки JWT (FR-41)
WIKIMCP_Jwt__Issuer=https://sso.example.internal/realms/corp
WIKIMCP_Jwt__Audience=central-wiki-mcp

# Экспорт трасс (NFR-43). Пусто — трассы никуда не отправляются.
OTEL_EXPORTER_OTLP_ENDPOINT=
